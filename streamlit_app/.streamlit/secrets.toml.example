# Copy to streamlit_app/.streamlit/secrets.toml and fill in. That file is
# gitignored: never commit it, and never commit the .p8 private key.

[connections.snowflake]
account = "your_account_identifier"        # e.g. ORGNAME-ACCOUNTNAME
user = "STREAMLIT_APP_USER"
authenticator = "SNOWFLAKE_JWT"            # key-pair auth
private_key_file = "/Users/you/.snowflake/keys/streamlit_app_rsa_key.p8"
# Hosted deploys (Streamlit Community Cloud) have no key file: remove
# private_key_file and paste the .p8 contents instead:
# private_key = """-----BEGIN PRIVATE KEY-----
# ...
# -----END PRIVATE KEY-----"""
role = "BI_READER"
warehouse = "WH_BI_QUERY"
database = "HR_ANALYTICS"

[app]
# Empty = prod/ci schema names (MARTS_CORE, MARTS_HR, ...).
# Set to your dbt dev target schema to read dev marts, e.g. "DEV_MAYURESH"
# -> DEV_MAYURESH_MARTS_CORE. The MARTS_SCHEMA_PREFIX env var overrides this.
marts_schema_prefix = ""
